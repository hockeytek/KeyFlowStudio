  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #0e1014;
}
QWidget {
    background-color: #11141a;
    color: #e8edf5;
    font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 13px;
}
QPushButton {
    background-color: #1b212b;
    border: 1px solid #2a3444;
    color: #eef3fb;
    padding: 6px 12px;
    border-radius: 9px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #243145;
    border: 1px solid #43c7ff;
}
QPushButton:pressed {
    background-color: #122235;
    border: 1px solid #21b8ff;
}
QPushButton:checked {
    background-color: #0f3c57;
    border: 1px solid #34c2ff;
    color: #f7fbff;
}
QPushButton:disabled {
    background-color: #131820;
    border: 1px solid #202835;
    color: #5b6473;
}
QComboBox {
    background-color: #171d27;
    border: 1px solid #2a3444;
    color: #e8edf5;
    padding: 4px 6px;
    border-radius: 8px;
    min-height: 28px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    min-width: 0px;
    max-width: 0px;
    width: 0px;
    border: none;
    margin: 0px;
    padding: 0px;
}
QComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
}
QComboBox:hover {
    border: 1px solid #43c7ff;
}
QComboBox QAbstractItemView {
    background-color: #131a23;
    color: #e8edf5;
    selection-background-color: #0f3c57;
    border: 1px solid #2a3444;
}
QSlider::groove:horizontal {
    height: 7px;
    background: #222c3a;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #28b8ff, stop:1 #5fd7ff);
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #eaf7ff;
    border: 2px solid #24bbff;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QProgressBar {
    background-color: #151c26;
    border: 1px solid #2a3444;
    border-radius: 7px;
    text-align: center;
    color: #d7e9f7;
    font-size: 11px;
    font-weight: 600;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1fa6ff, stop:1 #64d9ff);
    border-radius: 6px;
}
QSpinBox {
    background-color: #171d27;
    border: 1px solid #2a3444;
    color: #e8edf5;
    padding: 3px 8px;
    border-radius: 7px;
    min-height: 25px;
}
QCheckBox {
    color: #cfd7e3;
    font-size: 12px;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    border: 1px solid #3a4657;
    background-color: #171d27;
}
QCheckBox::indicator:checked {
    background-color: #24bbff;
    border: 1px solid #24bbff;
}
QFrame#line1, QFrame#line2 {
    color: #263244;
    background-color: #263244;
    max-height: 1px;
}
QLabel#lbl_brand {
    color: #d8f4ff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 0 6px;
}
QLabel#lbl_brand_badge {
    color: #8ce1ff;
    background-color: #16364a;
    border: 1px solid #27546e;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
}
QLabel#lbl_input_title,
QLabel#lbl_output_title,
QLabel#lbl_sec_params,
QLabel#lbl_sec_actions {
    color: #8ca0ba;
}
QLabel#input_video_label,
QLabel#output_video_label {
    background-color: #0b0f15;
    border: 1px solid #2a3444;
    border-radius: 12px;
    color: #6d7f95;
    font-size: 14px;
}
QLabel#input_video_label:hover,
QLabel#output_video_label:hover {
    border: 1px solid #43c7ff;
}
QPushButton#btn_play {
    font-size: 16px;
    font-weight: 700;
    color: #e8f7ff;
    min-width: 39px;
    max-width: 39px;
    min-height: 39px;
    max-height: 39px;
    border-radius: 6px;
    padding: 0;
    background-color: transparent;
    border: none;
}
QPushButton#btn_first_frame,
QPushButton#btn_prev_frame,
QPushButton#btn_next_frame,
QPushButton#btn_last_frame,
QPushButton#btn_play_loop {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    border-radius: 6px;
    font-size: 20px;
    font-weight: 700;
    padding: 0;
    background-color: transparent;
    border: none;
    color: #f2f7ff;
}
QPushButton#btn_play_reverse {
    min-width: 39px;
    max-width: 39px;
    min-height: 39px;
    max-height: 39px;
    border-radius: 6px;
    font-size: 20px;
    font-weight: 700;
    padding: 0;
    background-color: transparent;
    border: none;
    color: #f2f7ff;
}
QPushButton#btn_first_frame:hover,
QPushButton#btn_prev_frame:hover,
QPushButton#btn_play_reverse:hover,
QPushButton#btn_play:hover,
QPushButton#btn_next_frame:hover,
QPushButton#btn_last_frame:hover,
QPushButton#btn_play_loop:hover {
    color: #ffffff;
}
QPushButton#btn_first_frame:pressed,
QPushButton#btn_prev_frame:pressed,
QPushButton#btn_play_reverse:pressed,
QPushButton#btn_play:pressed,
QPushButton#btn_next_frame:pressed,
QPushButton#btn_last_frame:pressed,
QPushButton#btn_play_loop:pressed {
    color: #9ad7ff;
}
QSlider#frame_slider {
    min-height: 12px;
}
QSlider#frame_slider::groove:horizontal {
    border: none;
    height: 2px;
    border-radius: 1px;
    background: #42526b;
}
QSlider#frame_slider::sub-page:horizontal {
    border-radius: 1px;
    background: #95a7bf;
}
QSlider#frame_slider::add-page:horizontal {
    border-radius: 1px;
    background: #42526b;
}
QSlider#frame_slider::handle:horizontal {
    width: 6px;
    margin: -8px 0;
    border-radius: 2px;
    background: #f4f7fb;
    border: 1px solid #d2dde8;
}
QLabel#lbl_frame_info {
    color: #f2f9ff;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: 1px;
}
QLabel#lbl_playback_title {
    color: #8ca0ba;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}
QPushButton#btn_play:checked,
QPushButton#btn_play_reverse:checked,
QPushButton#btn_play_loop:checked {
    background-color: #0f3c57;
    border: 1px solid #34c2ff;
    color: #d9f6ff;
}</string>
